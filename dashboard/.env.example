# Copy this file to .env and change the URLs if needed.
# The proxy's management API always runs on the student's own laptop.
VITE_PROXY_API_URL=http://127.0.0.1:8889

# Local tutor backend. For the deployed site, set this to your Render URL,
# e.g. https://your-tutor.onrender.com
VITE_TUTOR_API_URL=http://127.0.0.1:8000
